{
  "name": "acgti",
  "private": true,
  "version": "0.4.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "validate:data": "node scripts/validate-character-data.mjs",
    "generate:data": "node scripts/build-character-data.mjs",
    "build": "node scripts/validate-character-data.mjs && node scripts/build-character-data.mjs && vue-tsc -b && vite build",
    "build:pages": "npm run build && npm run pages:finalize",
    "pages:finalize": "node scripts/postbuild-pages.mjs",
    "preview": "vite preview",
    "build:watch": "vite build --watch",
    "dev:pages": "node scripts/dev-pages.mjs",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e-smoke.mjs",
    "prewarm:insights": "node scripts/prewarm-insights.mjs",
    "generate:og": "node scripts/generate-og-image.mjs"
  },
  "dependencies": {
    "@unhead/vue": "^3.0.4",
    "html-to-image": "^1.11.13",
    "vue": "^3.5.32",
    "vue-router": "^4.6.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260825.1",
    "@types/node": "^24.12.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "puppeteer-core": "^25.9.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.126.0"
  }
}
